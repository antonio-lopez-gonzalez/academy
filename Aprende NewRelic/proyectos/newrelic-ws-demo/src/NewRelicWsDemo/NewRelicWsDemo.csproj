<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NewRelicWsDemo</RootNamespace>
    <AssemblyName>NewRelicWsDemo</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!--
      NewRelic.Agent  → profiler + carpeta newrelic/ en la salida.
      NewRelic.Agent.Api → instrumentación custom (no-op si el profiler no está adjunto).
      El profiler solo se carga si CORECLR_* están en el entorno ANTES de arrancar
      (Properties/launchSettings.json o scripts/run-with-agent.ps1).
    -->
    <PackageReference Include="NewRelic.Agent" Version="10.54.0" />
    <PackageReference Include="NewRelic.Agent.Api" Version="10.54.0" />
  </ItemGroup>

  <!--
    El agente busca newrelic.config junto al .exe y en CORECLR_NEWRELIC_HOME.
    Copiamos el del proyecto a ambos sitios (licencia, app, host EU).
  -->
  <Target Name="OverwriteNewRelicConfig" AfterTargets="Build;Publish" BeforeTargets="PrepareForRun"
          Condition="Exists('$(MSBuildProjectDirectory)\newrelic.config')">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\newrelic.config"
          DestinationFiles="$(TargetDir)newrelic.config"
          OverwriteReadOnlyFiles="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\newrelic.config"
          DestinationFiles="$(TargetDir)newrelic\newrelic.config"
          OverwriteReadOnlyFiles="true" />
  </Target>

</Project>
