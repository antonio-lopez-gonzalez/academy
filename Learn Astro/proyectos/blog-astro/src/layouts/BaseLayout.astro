---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Blog profesional del curso de Astro" } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://blog.example.com");
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header>
      <nav>
        <a href="/">Inicio</a>
        <a href="/blog/">Blog</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>Curso Astro · proyecto de ejemplo</p>
    </footer>
  </body>
</html>
