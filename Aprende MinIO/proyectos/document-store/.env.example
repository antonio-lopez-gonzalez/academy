# Copia este archivo a .env solo si necesitas cambiar los valores por defecto.
# El proyecto funciona sin .env porque `src/config.mjs` trae los mismos defaults.

MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=documentos
API_PORT=7072
MAX_UPLOAD_BYTES=26214400
PRESIGN_EXPIRY_SECONDS=900
WEBHOOK_URL=
MINIO_WEBHOOK_TOKEN=dev-token
CATALOG_PATH=./data/catalog.json
