{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Nota de Lumen",
  "description": "Contrato de datos de una nota. Fuente de verdad: spec/lumen.md.",
  "type": "object",
  "required": ["id", "title", "done", "createdAt"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Identificador único de la nota."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "Texto de la nota. No vacío."
    },
    "done": {
      "type": "boolean",
      "description": "true cuando la nota está cerrada."
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha de creación en ISO 8601."
    }
  }
}