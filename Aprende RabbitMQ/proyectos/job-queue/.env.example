# Copia este archivo a .env solo si necesitas cambiar los valores por defecto.
# El proyecto funciona sin .env porque `src/config.js` trae los mismos defaults.

RABBITMQ_URL=amqp://taller-api:taller-api-secret@localhost:5672/taller
API_PORT=3000
PREFETCH=10
JOB_LEASE_MS=60000
JOB_STORE=./data/jobs.json
