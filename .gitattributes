# =========================================================
# Academy — .gitattributes raíz
# Normaliza los finales de línea de todo el repositorio para
# acabar con el ruido CRLF/LF entre Windows, macOS y Linux.
# =========================================================

# Todo fichero de texto: detectado automáticamente y guardado con LF,
# también al hacer checkout en el working tree (LF en disco en Windows).
* text=auto eol=lf

# Excepciones que deben conservar CRLF (scripts de Windows)
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Binarios: Git no los normaliza ni intenta tratarlos como texto
*.woff   binary
*.woff2  binary
*.ttf    binary
*.otf    binary
*.eot    binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.pdf    binary
