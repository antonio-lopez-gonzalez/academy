# =========================================================
# Academy — .gitignore raíz
# Un único repositorio que agrupa todos los cursos.
# =========================================================

# ---------- Node / JavaScript / TypeScript ----------
node_modules/
.pnpm-store/
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tsbuildinfo
.eslintcache

# ---------- Build / salida de bundlers ----------
dist/
build/
out/
.output/
.cache/
.parcel-cache/
.vite/
.turbo/
.next/
.nuxt/
.svelte-kit/
.astro/

# ---------- Tests / cobertura ----------
coverage/
.nyc_output/
*.lcov

# ---------- .NET / C# ----------
bin/
obj/
*.user
*.suo
*.userprefs
.vs/
TestResults/
*.nupkg
*.snupkg
artifacts/
packages/
*.GeneratedMSBuildEditorConfig.editorconfig
*.g.cs
*.g.i.cs

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.hypothesis/
*.so

# ---------- Rust / Go (por si acaso) ----------
target/
Cargo.lock.bak

# ---------- Variables de entorno y secretos ----------
.env
.env.*
!.env.example
*.pfx
*.key
secrets.json

# ---------- Logs ----------
*.log
logs/

# ---------- Sistema operativo ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- Editores / IDE ----------
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo

# ---------- OpenCode ----------
.opencode/node_modules/
