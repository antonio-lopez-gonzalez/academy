<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuración del agente New Relic .NET para este demo.
  Se copia a bin/<Config>/net8.0/newrelic/newrelic.config al compilar.
  Las variables NEW_RELIC_* (launchSettings / entorno) tienen precedencia sobre este archivo.
-->
<configuration xmlns="urn:newrelic-config" agentEnabled="true">
  <!-- host EU: obligatorio si la cuenta no es US -->
  <service licenseKey="eu01xe7cc97da5e9f4d217d5d2320d6923e7NRAL"
           host="collector.eu.newrelic.com"
           sendDataOnExit="true" />

  <application>
    <name>NotificadorWebSocket</name>
  </application>

  <log level="info" />

  <distributedTracing enabled="true" excludeNewrelicHeader="false" />

  <errorCollector enabled="true" captureEvents="true" maxEventSamplesStored="100" />

  <transactionTracer enabled="true" transactionThreshold="apdex_f" />

  <applicationLogging enabled="true">
    <metrics enabled="true" />
    <forwarding enabled="true" maxSamplesStored="10000" />
    <localDecorating enabled="false" />
  </applicationLogging>
</configuration>
