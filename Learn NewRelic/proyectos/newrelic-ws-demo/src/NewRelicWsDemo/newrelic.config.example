<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuración de ejemplo del agente de New Relic .NET (no se usa por defecto:
  en este proyecto configuramos por variables de entorno, ver M1-03).

  Si prefieres configurar con este archivo en lugar de env vars:
    1. Sitúalo junto al ejecutable (se genera en bin/<Config>/newrelic/newrelic.config
       cuando añades el paquete NewRelic.Agent).
    2. Pon tu licenseKey y appName.
    3. Recuerda la precedencia: las variables de entorno ganan al archivo.

  XSD de referencia (instalación MSI): C:\ProgramData\New Relic\.NET Agent\newrelic.xsd
-->
<configuration xmlns="urn:newrelic-config" agentEnabled="true">
  <service licenseKey="YOUR_LICENSE_KEY" sendDataOnExit="false" />
  <application>
    <name>NotificadorWebSocket</name>
  </application>

  <!-- Distributed tracing (W3C traceparent/tracestate). Por defecto en agentes >= 9.0 -->
  <distributedTracing enabled="true" excludeNewrelicHeader="false" />

  <!-- Errores: captura y eventos de error -->
  <errorCollector enabled="true" captureEvents="true" maxEventSamplesStored="100" />

  <!-- Transacciones -->
  <transactionTracer enabled="true" transactionThreshold="apdex_f" />

  <!-- Logs en contexto: forwarding del agente + métricas -->
  <applicationLogging enabled="true">
    <metrics enabled="true" />
    <forwarding enabled="true" maxSamplesStored="10000" />
    <localDecorating enabled="false" />
  </applicationLogging>
</configuration>