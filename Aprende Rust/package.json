{
  "name": "aprende-rust",
  "version": "1.0.0",
  "type": "module",
  "description": "Curso completo de Rust — web estática y proyecto urlshort ejecutable",
  "scripts": {
    "serve": "node scripts/serve-web.mjs",
    "build:urlshort": "cargo build --manifest-path proyectos/urlshort/Cargo.toml",
    "test:urlshort": "cargo test --manifest-path proyectos/urlshort/Cargo.toml",
    "serve:urlshort": "cargo run --manifest-path proyectos/urlshort/Cargo.toml -- serve"
  },
