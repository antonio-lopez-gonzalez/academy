{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Biblioteca — catálogo",
  "description": "Contrato de datos del almacén. Fuente de verdad: especificación del proyecto.",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "title", "kind", "borrowed"],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1,
        "description": "Identificador único del ítem."
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "description": "Título del libro o de la película."
      },
      "kind": {
        "type": "string",
        "enum": ["book", "movie"],
        "description": "Tipo de ítem."
      },
      "year": {
        "type": ["integer", "null"],
        "description": "Año de publicación o estreno (opcional)."
      },
      "borrowed": {
        "type": "boolean",
        "description": "true si está prestado."
      },
      "author": {
        "type": ["string", "null"],
        "description": "Autor (solo libros)."
      },
      "director": {
        "type": ["string", "null"],
        "description": "Director (solo películas)."
      }
    }
  }
}