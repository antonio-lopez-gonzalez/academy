# ─── MÓDULO 16 ─── .dockerignore ───
# Archivos y carpetas que NO se copian al contexto de build de Docker
# Reduce el tamaño del contexto y acelera el build

# Dependencias
**/node_modules/
**/packages/

# Build output
**/bin/
**/obj/
**/out/
**/publish/

# Git
.git/
.gitignore
.gitattributes

# IDE
.vs/
.vscode/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates

# OS
.DS_Store
Thumbs.db

# Secrets (NUNCA incluir en la imagen)
appsettings.*.local.json
*.pfx
*.pem
secrets.json
.env
.env.local

# Docker
Dockerfile
docker-compose.yml
.dockerignore

# CI/CD
.github/
.github/workflows/

# Test
tests/
**/*.Tests/
**/TestResults/
coverage/

# Documentación
*.md
docs/

# Archivos temporales
*.tmp
*.log
*.swp
